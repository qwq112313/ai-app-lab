import folium
from folium.plugins import TimestampedGeoJson

# 创建地图对象
m = folium.Map(location=[34.3, 108.9], zoom_start=5)

# 示例数据（叛军移动轨迹）
geojson_data = {
    "type": "FeatureCollection",
    "features": [
        {
            "type": "Feature",
            "geometry": {
                "type": "LineString",
                "coordinates": [[115.4, 38.0], [114.3, 34.2], [108.9, 34.3]]
            },
            "properties": {
                "times": ["755-12-15", "756-01-10", "756-06-01"],
                "style": {"color": "red"}
            }
        }
    ]
}

TimestampedGeoJson(geojson_data, period="P1M", add_last_point=True).add_to(m)
m.save('anlushan_map.html')
